# Radly Environment Configuration
# Copy this file to .env and configure your values:
#   cp .env.example .env

# --- Database Configuration ---
# Local development (SQLite):
RBR_DB_URL=sqlite+pysqlite:///./rbr_local.db
# Production (PostgreSQL / Supabase / Neon):
# RBR_DB_URL=postgresql://username:password@localhost:5432/radly

# --- LLM Provider Configuration (Groq) ---
RBR_LLM_PROVIDER=groq
RBR_LLM_MODEL=openai/gpt-oss-120b
RBR_LLM_API_KEY=your_groq_api_key_here
RBR_LLM_TEMPERATURE=0.0
RBR_LOG_LEVEL=INFO

# Legacy / server fallback aliases
GROQ_API_KEY=your_groq_api_key_here
LOG_LEVEL=INFO
PORT=5000

# --- Authentication & JWT Security ---
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=change_this_to_a_secure_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=radly_auth
JWT_AUDIENCE=radly
