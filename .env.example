# Radly Environment Configuration
# Copy this file to .env and configure your values:
#   cp .env.example .env

# --- LLM Provider Configuration (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Server & Logging ---
PORT=5000
LOG_LEVEL=INFO

# --- Authentication & JWT Security ---
# Must be at least 32 characters (256 bits)
JWT_SECRET=change_this_to_a_secure_random_secret_at_least_32_bytes
