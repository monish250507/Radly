{
  "name": "paperblast-impact-analyzer",
  "version": "1.0.0",
  "description": "Research Code & Paper Impact Analyzer - Bipartite AST & Blast Radius Engine",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite client --host",
