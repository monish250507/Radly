{
  "name": "radly-impact-analyzer",
  "version": "1.0.0",
  "description": "Radly — Research Code & Paper Impact Analyzer - Bipartite AST & Blast Radius Engine",
  "type": "module",
  "scripts": {
    "server": "uvicorn server.main:app --host 0.0.0.0 --port 5000",
    "client": "vite client --host",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build client --outDir ../dist",
    "test": "pytest server/tests/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "vercel": "^59.1.3",
    "vite": "^5.3.1"
  }
}
