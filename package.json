    "mammoth": "^1.8.0",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "vercel": "^59.1.3",
    "vite": "^5.3.1"
  }
